<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.kube-tmux</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/drmorr/.local/bin/tmux-kube-update.sh</string>
  </array>

  <key>WatchPaths</key>
  <array>
    <string>/Users/drmorr/.kube</string>
    <string>/Users/drmorr/.kube/config</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>1</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>StandardErrorPath</key>
  <string>/tmp/kube-tmux.err</string>
</dict>
</plist>
